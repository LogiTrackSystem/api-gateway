INTERNAL_API_KEY=
# Calentamiento de microservicios al arrancar el gateway (Render gratis los duerme tras ~15 min). Todo es opcional.
# WARMUP_ACTIVO=true          # false lo desactiva (útil en local)
# WARMUP_INTENTOS=5           # intentos por servicio
# WARMUP_PAUSA_S=4            # segundos entre intentos
# WARMUP_TIMEOUT_S=15         # espera máxima de cada intento
# WARMUP_INTERVALO_MIN=0      # 0 = solo al arrancar; N = repetir cada N min mientras el gateway esté despierto
# WARMUP_SERVICIOS=           # vacío = todos; o nombres separados por coma, p. ej. fleet,billing
