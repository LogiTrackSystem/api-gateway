JWT_SECRET=cambia-esto-por-tu-propio-secreto-local
FLEET_SERVICE_URL=http://localhost:8000
SHIPMENT_SERVICE_URL=http://localhost:8001
ROUTING_SERVICE_URL=http://localhost:8003
TRACKING_SERVICE_URL=http://localhost:8004
MAINTENANCE_SERVICE_URL=http://localhost:8005
CUSTOMS_SERVICE_URL=http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8007
BILLING_SERVICE_URL=http://localhost:8008
ANALYTICS_SERVICE_URL=http://localhost:8009
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
GATEWAY_TIMEOUT_S=65
# Clave compartida con el gateway y los demás servicios (producción). Vacía = sin restricción (local).
INTERNAL_API_KEY=
# Calentamiento y health checks periódicos de los microservicios (Render gratis los duerme tras ~15 min). Todo es opcional.
# Ojo: mantenerlos despiertos gasta las 750 horas/mes del workspace (ver README). Desactívalo cuando no lo necesites.
# WARMUP_ACTIVO=true            # false lo desactiva (útil en local)
# WARMUP_INTERVALO_MIN=5        # minutos entre comprobaciones por servicio: 5 (300 s) o 10 (600 s); 0 = solo al arrancar; debe ser < 15
# WARMUP_INTENTOS_PERIODICOS=2  # intentos por comprobación periódica
# WARMUP_INTENTOS=0             # intentos del calentamiento inicial; 0 = sin límite (24 si hay comprobación periódica)
# WARMUP_PAUSA_S=5              # segundos entre intentos
# WARMUP_TIMEOUT_S=30           # espera máxima de cada intento
# WARMUP_SERVICIOS=             # vacío = todos; o nombres separados por coma, p. ej. fleet,billing
